<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标前景：抽象的「文件管理器」符号——一个文件夹轮廓加一条高亮条。
  使用矢量图而非 PNG，既避免二进制资源，也能在任意密度下保持锐利。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 文件夹主体 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,38h18l5,6h29a4,4 0 0 1 4,4v26a4,4 0 0 1 -4,4H28a4,4 0 0 1 -4,-4V42a4,4 0 0 1 4,-4z" />

    <!-- 高亮条，暗示「多标签/多面板」语义 -->
    <path
        android:fillColor="#80CBC4"
        android:pathData="M32,60h44v6H32z" />
</vector>
